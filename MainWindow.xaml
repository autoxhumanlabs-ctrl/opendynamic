<Window x:Class="Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island" Width="560" Height="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextRenderingMode="Grayscale" Foreground="White">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="White"/>
        <SolidColorBrush x:Key="AccentGrad" Color="White"/>
        <SolidColorBrush x:Key="WaveFill" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="WaveFill2" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="WaveCrest" Color="#AAFFFFFF"/>
        <SolidColorBrush x:Key="Rim" Color="#33FFFFFF"/>

        <!-- On/off switch for the settings tab -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="track" Width="30" Height="17" CornerRadius="8.5" Background="#33FFFFFF" HorizontalAlignment="Right">
                                <Ellipse x:Name="knob" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentGrad}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Fill" Value="#FF111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="99" RenderTransformOrigin=".5,.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX=".86" ScaleY=".86"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="GroupName" Value="Tabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="11" Padding="12,3">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tappable row/tile on the clipboard, links and markets tabs -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#17FFFFFF"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2BFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentGrad}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="16" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekBar" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="16" Height="16" Background="Transparent">
                                                    <Ellipse x:Name="glow" Fill="{DynamicResource Accent}" Opacity=".3"/>
                                                    <Ellipse x:Name="dot" Width="9" Height="9" Fill="White"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="dot" Property="Width" Value="12"/>
                                                        <Setter TargetName="dot" Property="Height" Value="12"/>
                                                        <Setter TargetName="glow" Property="Opacity" Value=".6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ears + island in one row: ears follow width, and one translate slides the whole notch up into the edge. -->
    <StackPanel x:Name="NotchRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel.RenderTransform><TranslateTransform x:Name="RowShift"/></StackPanel.RenderTransform>
        <Path x:Name="EarL" Fill="Black" VerticalAlignment="Top" Visibility="Collapsed" Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z"/>
        <Border x:Name="Island" Width="180" Height="30" VerticalAlignment="Top" Background="Black" AllowDrop="True">
            <Grid>
                <!-- Idle: a small clock so the notch is never an empty black blob -->
                <TextBlock x:Name="IdleClock" FontSize="12" FontWeight="SemiBold" Foreground="#D0FFFFFF" HorizontalAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                <!-- Compact: spinning mini disc + live bars -->
                <Grid x:Name="Compact" Margin="6,0,12,0" IsHitTestVisible="False">
                    <!-- Beat ripple: a ring that pops out of the disc and fades on every kick -->
                    <Ellipse x:Name="BeatRing" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="{DynamicResource AccentGrad}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin=".5,.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- Track progress hairline along the bottom, flares on the beat -->
                    <Rectangle x:Name="ProgLine" Height="2" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Margin="8,0,2,2" Fill="{DynamicResource AccentGrad}" Opacity=".5">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="ProgScale" ScaleX="0"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
                        <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="MiniThump"/><RotateTransform x:Name="MiniSpin"/></TransformGroup></Grid.RenderTransform>
                        <Ellipse x:Name="MiniArt" Fill="#2A2A2A"/>
                        <Ellipse Width="5" Height="5" Fill="Black"/>
                    </Grid>
                    <StackPanel x:Name="MiniBars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Expanded card: fixed width so nothing reflows while the spring animates -->
                <Grid x:Name="Expanded" Width="480" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" Background="Transparent">
                    <!-- Ambient glow: blurred cover + shade, pre-rendered once per track (see AmbientBrush) -->
                    <!-- Liquid Glass: what's behind the card, frosted + refracted at the edges (see Glass.cs) -->
                    <Canvas x:Name="GlassLayer" Margin="-24,0" ClipToBounds="True" Visibility="Collapsed" IsHitTestVisible="False">
                        <Image x:Name="GlassImg" Width="528" Height="460" Stretch="Fill"/>
                    </Canvas>
                    <Border x:Name="Ambient" Margin="-24,0"/>
                    <Border x:Name="GlassSheen" Margin="-24,0" IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#18FFFFFF" Offset="0"/>
                                <GradientStop Color="#04FFFFFF" Offset=".3"/>
                                <GradientStop Color="#00FFFFFF" Offset=".55"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Experimental: aurora blobs breathing with the bass + embers rising, bursting on kicks (see Fx.cs) -->
                    <Canvas x:Name="Fx" Margin="-24,0" IsHitTestVisible="False" ClipToBounds="True"/>
                    <!-- Liquid beat wave: back layer (2nd accent), front layer (accent), glowing crest line -->
                    <Grid x:Name="WaveLayer" Height="96" VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <Path x:Name="WaveBack" Fill="{DynamicResource WaveFill2}"/>
                        <Path x:Name="WaveFront" Fill="{DynamicResource WaveFill}"/>
                        <Path x:Name="WaveCrest" Stroke="{DynamicResource WaveCrest}" StrokeThickness="1.3"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>

                    <StackPanel Margin="22,9,22,14">
                        <Grid Height="18">
                            <TextBlock x:Name="HeaderLeft" Foreground="#AAFFFFFF" FontSize="12" VerticalAlignment="Center"/>
                            <Border x:Name="VolPill" HorizontalAlignment="Center" Opacity="0" Background="#33FFFFFF" CornerRadius="9" Padding="10,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="VolText" FontSize="11" VerticalAlignment="Center"/>
                                    <Grid Width="54" Height="4" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border CornerRadius="2" Background="#33FFFFFF"/>
                                        <Border x:Name="VolFill" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentGrad}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="Battery" Foreground="#AAFFFFFF" FontSize="12" Margin="0,0,10,0"/>
                                <TextBlock x:Name="Clock" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <RadioButton x:Name="TabMusic" Style="{StaticResource TabBtn}" Content="Music" IsChecked="True"/>
                            <RadioButton x:Name="TabClip" Style="{StaticResource TabBtn}" Content="Clipboard"/>
                            <RadioButton x:Name="TabLinks" Style="{StaticResource TabBtn}" Content="Links"/>
                            <RadioButton x:Name="TabMarkets" Style="{StaticResource TabBtn}" Content="Markets"/>
                            <RadioButton x:Name="TabSettings" Style="{StaticResource TabBtn}" Content="Settings"/>
                        </StackPanel>

                        <!-- Settings: saved in HKCU\Software\Island -->
                        <StackPanel x:Name="SettingsPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="-12,0,0,8">
                                <RadioButton x:Name="PageGeneral" Style="{StaticResource TabBtn}" GroupName="SetPage" Content="General" FontSize="11" IsChecked="True"/>
                                <RadioButton x:Name="PageLook" Style="{StaticResource TabBtn}" GroupName="SetPage" Content="Liquid Glass" FontSize="11"/>
                            </StackPanel>
                            <StackPanel x:Name="GeneralPage">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Wave strength" FontSize="12" Foreground="#AAFFFFFF" VerticalAlignment="Center"/>
                                <Slider x:Name="SetWave" Grid.Column="1" Style="{StaticResource SeekBar}" Minimum=".5" Maximum="2.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Beat sensitivity" FontSize="12" Foreground="#AAFFFFFF" VerticalAlignment="Center"/>
                                <Slider x:Name="SetBeat" Grid.Row="1" Grid.Column="1" Style="{StaticResource SeekBar}" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Text="Colour" FontSize="12" Foreground="#AAFFFFFF" VerticalAlignment="Center"/>
                                <StackPanel x:Name="Swatches" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </Grid>
                            <UniformGrid x:Name="Toggles" Columns="2" Margin="0,10,-14,0"/>
                            </StackPanel>
                            <StackPanel x:Name="LookPage" Visibility="Collapsed">
                                <StackPanel x:Name="LookSliders"/>
                                <UniformGrid x:Name="LookToggles" Columns="2" Margin="0,10,-14,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Clipboard history: click = copy again, right-click = forget. Memory only, never saved. -->
                        <Grid x:Name="ClipPanel" Margin="0,10,0,0" Height="164" Visibility="Collapsed">
                            <TextBlock x:Name="ClipEmpty" Text="Copy some text and it shows up here" FontSize="12" Foreground="#77FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="ClipItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Tile}" Padding="12,7" Margin="0,0,0,5" ToolTip="Click to copy · right-click to remove"
                                                    MouseLeftButtonUp="Clip_Click" MouseRightButtonUp="Clip_Remove">
                                                <TextBlock Text="{Binding Preview}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Links from %AppData%\Island\links.txt -->
                        <ItemsControl x:Name="LinkItems" Margin="-3,8,-3,0" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Tile}" Margin="3" Padding="9,8" ToolTip="{Binding Url}" MouseLeftButtonUp="Link_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="22" CornerRadius="7" Background="{Binding Badge}">
                                                <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="92" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Markets: gold, silver, Nasdaq 100 with a day sparkline; click opens the TradingView chart -->
                        <StackPanel x:Name="MarketsPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <ItemsControl x:Name="MarketItems" Margin="-3,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tile}" Margin="3" Padding="12,9" ToolTip="Open chart on TradingView" MouseLeftButtonUp="Market_Click">
                                            <StackPanel>
                                                <TextBlock FontSize="12" Foreground="#AAFFFFFF">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Sub, Mode=OneWay}" Foreground="#55FFFFFF"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PriceText}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding ChangeText}" FontSize="11.5" Foreground="{Binding ChangeBrush}"/>
                                                <Path Data="{Binding Spark}" Stroke="{Binding ChangeBrush}" StrokeThickness="1.6" Stretch="Fill"
                                                      Height="26" Margin="0,7,0,0" StrokeLineJoin="Round"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="MarketNote" FontSize="10.5" Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid x:Name="MediaPanel" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Vinyl slides out from behind the cover while playing and spins -->
                            <Grid Width="114" Height="82" HorizontalAlignment="Left">
                                <Grid Width="76" Height="76" HorizontalAlignment="Left" Margin="3,3,0,0">
                                    <Grid.RenderTransform><TranslateTransform x:Name="DiscSlide"/></Grid.RenderTransform>
                                    <Grid RenderTransformOrigin=".5,.5">
                                        <Grid.RenderTransform><RotateTransform x:Name="DiscSpin"/></Grid.RenderTransform>
                                        <Ellipse Fill="#FF0D0D0D" Stroke="#30FFFFFF" StrokeThickness="1"/>
                                        <Ellipse Margin="6" Stroke="#14FFFFFF" StrokeThickness="1"/>
                                        <Ellipse Margin="11" Stroke="#14FFFFFF" StrokeThickness="1"/>
                                        <Ellipse Margin="16" Stroke="#14FFFFFF" StrokeThickness="1"/>
                                        <Ellipse x:Name="DiscLabel" Width="32" Height="32" Fill="#333"/>
                                        <Ellipse Width="5" Height="5" Fill="Black"/>
                                    </Grid>
                                    <Ellipse IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#26FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset=".45"/>
                                                <GradientStop Color="#00FFFFFF" Offset=".6"/>
                                                <GradientStop Color="#14FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <Border Width="82" Height="82" HorizontalAlignment="Left" RenderTransformOrigin=".5,.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="ArtPause"/>
                                            <ScaleTransform x:Name="ArtFlip"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Border Margin="-6,0,-6,-10" CornerRadius="20">
                                            <Border.Background>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#AA000000" Offset=".55"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="Art" CornerRadius="14" Background="#2A2A2A"/>
                                        <Border CornerRadius="14" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="TextCol" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <StackPanel.RenderTransform><TranslateTransform x:Name="TextShift"/></StackPanel.RenderTransform>
                                <TextBlock x:Name="TrackTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="Artist" FontSize="13" Foreground="#AAFFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LyricLine" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Accent}"
                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0" Visibility="Collapsed">
                                    <TextBlock.RenderTransform><TranslateTransform x:Name="LyricShift"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="BigBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="30" Margin="0,0,2,0"/>

                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Elapsed" FontSize="11" Foreground="#AAFFFFFF" VerticalAlignment="Center"/>
                                <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource SeekBar}" Minimum="0" Maximum="1"/>
                                <TextBlock x:Name="Remaining" Grid.Column="2" FontSize="11" Foreground="#AAFFFFFF"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button x:Name="ShuffleBtn" Style="{StaticResource IconBtn}" Width="32" Height="32" Foreground="#99FFFFFF" ToolTip="Shuffle">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
                                          Width="15" Height="15" Stretch="Uniform"
                                          Data="M3,7 H7 L15,17 H21 M17,13 L21,17 L17,21 M3,17 H7 L9.5,14 M12.5,10 L15,7 H21 M17,3 L21,7 L17,11"/>
                                </Button>
                                <Button x:Name="PrevBtn" Style="{StaticResource IconBtn}" Margin="10,0,0,0">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16"
                                          Stretch="Uniform" Data="M18,6 L10,12 L18,18 Z M6,6 H8 V18 H6 Z"/>
                                </Button>
                                <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Width="50" Height="50" Margin="12,0">
                                    <Path x:Name="PlayIcon" Fill="White" Width="22" Height="22" Stretch="Uniform" RenderTransformOrigin=".5,.5"
                                          Data="M8,5 L19,12 L8,19 Z">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="PlayScale"/>
                                                <RotateTransform x:Name="PlayTurn"/>
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                    </Path>
                                </Button>
                                <Button x:Name="NextBtn" Style="{StaticResource IconBtn}" Margin="0,0,10,0">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16"
                                          Stretch="Uniform" Data="M6,6 L14,12 L6,18 Z M16,6 H18 V18 H16 Z"/>
                                </Button>
                                <Button x:Name="RepeatBtn" Style="{StaticResource IconBtn}" Width="32" Height="32" Foreground="#99FFFFFF" ToolTip="Repeat">
                                    <Grid>
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
                                              Width="15" Height="15" Stretch="Uniform"
                                              Data="M4,11 V9 A3,3 0 0 1 7,6 H20 M16,2 L20,6 L16,10 M20,13 V15 A3,3 0 0 1 17,18 H4 M8,22 L4,18 L8,14"/>
                                        <TextBlock x:Name="RepeatOne" Text="1" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Visibility="Collapsed"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <Button x:Name="SwitchBtn" Grid.Row="2" Grid.Column="2" Style="{StaticResource IconBtn}" Width="30" Height="30"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Switch player">
                                <Path Stroke="#BBFFFFFF" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"
                                      Data="M4,7 H18 M14,3 L18,7 L14,11 M20,17 H6 M10,13 L6,17 L10,21"/>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="ClockPanel" Margin="0,2,0,6" Visibility="Collapsed">
                            <TextBlock x:Name="BigClock" FontSize="46" FontWeight="Light" Foreground="{DynamicResource AccentGrad}"/>
                            <TextBlock Text="Nothing playing · push the cursor to the top edge to open me" FontSize="12" Foreground="#77FFFFFF"/>
                        </StackPanel>

                        <Grid x:Name="Shelf" Margin="0,12,0,0" Height="32" Visibility="Collapsed">
                            <Border CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" x:Name="ShelfHint">
                                <TextBlock Text="Drop files to keep them here" FontSize="12" Foreground="#88FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,34,0">
                                <ItemsControl x:Name="ShelfItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#26FFFFFF" CornerRadius="10" Padding="10,7" Margin="0,0,6,0" Cursor="Hand"
                                                    ToolTip="{Binding FullPath}" MouseMove="Chip_MouseMove" MouseRightButtonUp="Chip_RightClick">
                                                <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button x:Name="ClearShelf" Style="{StaticResource IconBtn}" Width="28" Height="28"
                                    HorizontalAlignment="Right" ToolTip="Clear shelf">
                                <Path Stroke="#BBFFFFFF" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" Data="M0,0 L10,10 M10,0 L0,10"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
                <!-- Accent hairline along the bottom edge (the shape itself, incl. the curved shoulders, is Island.Clip) -->
                <Path x:Name="RimPath" Stroke="{DynamicResource Rim}" StrokeThickness="2" IsHitTestVisible="False"/>
                <!-- Liquid Glass edge: a specular highlight that follows the cursor and swells with the bass -->
                <Path x:Name="GlassEdge" StrokeThickness="2.6" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <Path x:Name="EarR" Fill="Black" VerticalAlignment="Top" Visibility="Collapsed" Data="M10,0 L0,0 L0,10 A10,10 0 0 1 10,0 Z"/>
    </StackPanel>
</Window>
